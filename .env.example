# Taj Al Asna — environment variables
# Copy to .env.local for local dev, or set these in your Vercel project settings.
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) so the key never reaches the browser.

# Origin of the hosted RAG assistant (الباحث الذكي). No trailing slash, no /api.
# Example: https://taj-rag.up.railway.app
RAG_API_URL=

# Shared secret the RAG service checks (sent as the x-api-key header by /api/assistant).
# Leave blank only if the RAG service has no auth (not recommended in production).
RAG_API_KEY=

# Public base URL for audio files hosted on Cloudflare R2 (NEXT_PUBLIC_ = safe for the browser).
# A default (the r2.dev URL) is baked into src/lib/audio.ts; set this to override — e.g. once you
# attach a custom domain like https://audio.tajasna.org. No trailing slash.
NEXT_PUBLIC_AUDIO_BASE_URL=

# R2 read-only credentials so /api/audio can LIST the bucket (server-only — never NEXT_PUBLIC).
# Create at Cloudflare → R2 → "Manage R2 API Tokens" (Object Read only, scoped to the bucket).
# The account id is in the S3 endpoint it shows: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taj-audio
# Optional: only list a sub-folder, e.g. Duas/  (leave blank to list the whole bucket)
R2_AUDIO_PREFIX=
